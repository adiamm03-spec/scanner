<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b2b45">
<title>PERPUS — Scanner Kamera REV7</title>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<style>
:root{--navy:#0b2b45;--navy2:#082033;--ink:#142234;--muted:#65758a;--line:#dbe4ec;--ok:#13885d;--bad:#c23831;--warn:#aa7311}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:linear-gradient(180deg,#eaf1f7,#f8fafc);color:var(--ink)}
body{display:flex;justify-content:center;padding:12px}.app{width:min(820px,100%)}
.top{background:linear-gradient(145deg,var(--navy),var(--navy2));color:#fff;border-radius:24px;padding:20px;box-shadow:0 18px 45px rgba(8,32,51,.16)}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:800;opacity:.75}.top h1{margin:6px 0 5px;font-size:26px}.top p{margin:0;color:#c7d8e5;font-size:13px;line-height:1.6}
.card{background:rgba(255,255,255,.98);border:1px solid rgba(219,228,236,.92);border-radius:20px;padding:16px;margin-top:14px;box-shadow:0 10px 32px rgba(18,34,52,.07)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field label{display:block;font-size:11px;font-weight:800;color:#475467;margin-bottom:6px}.field select,.field input{width:100%;border:1px solid var(--line);border-radius:12px;padding:12px 13px;font-size:14px;background:#fff;color:var(--ink);outline:none}.field select:focus,.field input:focus{border-color:#6b89a0;box-shadow:0 0 0 3px rgba(59,93,118,.11)}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.btn{border:0;border-radius:12px;padding:12px 14px;font-weight:800;cursor:pointer;background:#eef3f7;color:#17364f}.btn.primary{background:var(--navy);color:#fff}.btn.danger{background:#fbe9e7;color:#9f281f}.btn:disabled{opacity:.45;cursor:not-allowed}
.reader-shell{position:relative;width:100%;min-height:420px;border-radius:18px;overflow:hidden;background:#061522}.reader{width:100%;min-height:420px;background:#061522}.reader video{width:100%!important;max-height:66vh;object-fit:cover;background:#061522}.scan-overlay{position:absolute;inset:0;pointer-events:none;display:flex;align-items:center;justify-content:center}.scan-box{width:min(88%,600px);height:min(30vw,175px);max-height:175px;border:3px solid rgba(255,255,255,.95);border-radius:16px;box-shadow:0 0 0 9999px rgba(0,0,0,.20),0 0 0 7px rgba(11,43,69,.18)}
.empty{min-height:420px;display:flex;align-items:center;justify-content:center;color:#9cb0bf;text-align:center;padding:24px}.status{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;margin-top:10px}.dot{width:9px;height:9px;border-radius:50%;background:#8da0ad}.status.ok .dot{background:var(--ok)}.status.bad .dot{background:var(--bad)}.status.warn .dot{background:var(--warn)}
.msg{display:none;border-radius:12px;padding:11px 12px;margin-top:12px;font-size:12px;line-height:1.55}.msg.show{display:block}.msg.ok{background:#e9f8f1;color:#116947}.msg.bad{background:#fff0ef;color:#a62d26}.msg.warn{background:#fff7e8;color:#8a5d0f}.msg.info{background:#edf5fb;color:#1b4d70}
.diag{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}.diag-item{border:1px solid var(--line);border-radius:12px;padding:10px;background:#fbfdff}.diag-item small{display:block;color:var(--muted);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.diag-item strong{display:block;margin-top:4px;font-size:12px;line-height:1.3}
.result{margin-top:12px;border:1px solid var(--line);border-radius:14px;padding:13px;background:#fbfdff}.result .label{font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.result .code{font:800 19px ui-monospace,SFMono-Regular,Menlo,monospace;margin-top:5px;word-break:break-all}.help{font-size:11px;color:#667085;line-height:1.65}.foot{padding:10px 2px 0;color:#7c8b9a;font-size:10px;text-align:center}
.test-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.small{font-size:10px;color:var(--muted);line-height:1.45}
#reader__dashboard_section_csr{padding-top:4px!important}#reader__dashboard_section_swaplink{display:none!important}#reader img{max-width:100%}
@media(max-width:700px){body{padding:8px}.grid,.test-grid{grid-template-columns:1fr}.diag{grid-template-columns:1fr 1fr}.reader-shell,.reader,.empty{min-height:320px}.scan-box{height:150px}.actions .btn{flex:1;min-width:130px}}
</style>
</head>
<body>
<main class="app">
<header class="top">
<div class="eyebrow">PERPUS SD NEGERI 5 PANJI</div>
<h1>Scanner Kamera</h1>
<p>REV7 menggunakan mesin scanner yang sudah terbukti berjalan pada versi sebelumnya, dengan dukungan khusus Code 128 dan QR Code.</p>
</header>
<section class="card">
<div class="grid">
<div class="field"><label>Mode Scan</label><select id="mode"><option value="AUTO">Otomatis</option><option value="MEMBER">Kartu Anggota</option><option value="BOOK">Barcode Buku</option></select></div>
<div class="field"><label>Kamera</label><select id="camera"><option value="">Kamera default</option></select></div>
</div>
<div class="actions">
<button class="btn primary" id="startBtn" type="button">Izinkan &amp; Mulai Kamera</button>
<button class="btn" id="switchBtn" type="button">Ganti Kamera</button>
<button class="btn" id="torchBtn" type="button" hidden>Lampu</button>
<button class="btn danger" id="stopBtn" type="button">Hentikan</button>
</div>
<div id="msg" class="msg"></div>
</section>
<section class="card">
<div class="reader-shell">
<div id="reader" class="reader"></div>
<div id="readerEmpty" class="empty">Kamera belum dimulai.<br>Tekan <strong>“Izinkan &amp; Mulai Kamera”</strong>.</div>
<div class="scan-overlay"><div class="scan-box"></div></div>
</div>
<div id="status" class="status warn"><span class="dot"></span><span>Scanner belum aktif.</span></div>
<div class="diag">
<div class="diag-item"><small>Secure</small><strong id="diagSecure">—</strong></div>
<div class="diag-item"><small>Camera API</small><strong id="diagApi">—</strong></div>
<div class="diag-item"><small>Permission</small><strong id="diagPermission">—</strong></div>
<div class="diag-item"><small>Kamera</small><strong id="diagCameras">—</strong></div>
</div>
</section>
<section class="card">
<div class="field"><label>Input Manual / Scanner USB</label><input id="manual" autocomplete="off" placeholder="Contoh: ANG-00001 atau BK-00001-01"></div>
<div class="actions"><button class="btn primary" id="manualBtn" type="button">Kirim Kode</button><button class="btn" id="diagnosticBtn" type="button">Tes Kamera</button></div>
<div id="result" class="result" hidden></div>
</section>
<section class="card">
<strong>Uji barcode dari gambar</strong>
<p class="small">Gunakan ini untuk membuktikan apakah file barcode yang Anda hasilkan memang dapat dibaca. Pilih gambar/screenshot barcode lalu klik “Uji Gambar”. Tes ini tidak membutuhkan kamera.</p>
<div class="test-grid">
<div class="field"><label>File barcode</label><input id="barcodeFile" type="file" accept="image/*"></div>
<div class="actions" style="align-items:end"><button class="btn" id="testImageBtn" type="button">Uji Gambar</button></div>
</div>
<div id="imageTestMsg" class="msg"></div>
</section>
<section class="card help">
<strong>Catatan penting:</strong><br>
Scanner ini dapat dijalankan sebagai halaman HTTPS mandiri. Ketika dipanggil dari Web App PERPUS, hasil scan dikirim kembali melalui <code>postMessage</code> dengan nonce sesi. Kamera tetap menggunakan halaman scanner HTTPS karena HTML Service Apps Script dapat membatasi akses kamera pada iframe.<br><br>
Untuk barcode buku, arahkan barcode <strong>secara horizontal</strong>, isi sebagian besar kotak putih, beri jarak sekitar 10–30 cm terlebih dahulu, dan tunggu fokus kamera mengunci. Barcode Code 128 dengan kontras hitam-putih paling mudah dibaca.
</section>
<div class="foot">PERPUS Scanner REV7 • HTML5 QRCode 2.3.8 • QR Code + Code 128 • Camera + USB + Manual</div>
</main>
<script>
(()=>{
const p=new URLSearchParams(location.search), initialMode=p.get('mode')||'AUTO', nonce=p.get('nonce')||'', embedded=p.get('embed')==='1'||window.top!==window.self;
const $=id=>document.getElementById(id);
const state={scanner:null,running:false,cameras:[],activeId:'',last:'',lastAt:0,torch:false,track:null};
$('mode').value=['AUTO','MEMBER','BOOK'].includes(initialMode)?initialMode:'AUTO';
function setMsg(type,text){const e=$('msg');e.className='msg show '+type;e.textContent=text;}
function setImgMsg(type,text){const e=$('imageTestMsg');e.className='msg show '+type;e.textContent=text;}
function setStatus(type,text){const e=$('status');e.className='status '+type;e.innerHTML='<span class="dot"></span><span></span>';e.querySelector('span:last-child').textContent=text;}
function safeText(s){return String(s??'');}
function postStatus(kind,message){try{const payload={type:'PERPUS_SCANNER_STATUS',kind:safeText(kind),message:safeText(message)};if(window.opener&&!window.opener.closed)window.opener.postMessage(payload,'*');if(embedded&&window.parent&&window.parent!==window)window.parent.postMessage(payload,'*');}catch(e){}}
function beep(){try{const C=window.AudioContext||window.webkitAudioContext;if(!C)return;const c=new C(),o=c.createOscillator(),g=c.createGain();o.frequency.value=900;g.gain.value=.04;o.connect(g);g.connect(c.destination);o.start();setTimeout(()=>{o.stop();c.close()},80)}catch(e){}}
async function perm(){if(!navigator.permissions?.query)return 'tidak tersedia';try{return (await navigator.permissions.query({name:'camera'})).state||'unknown'}catch(e){return 'tidak tersedia'}}
async function diagnostics(){
$('diagSecure').textContent=window.isSecureContext?'OK':'TIDAK';
$('diagApi').textContent=navigator.mediaDevices?.getUserMedia?'OK':'TIDAK';
$('diagPermission').textContent=await perm();
try{const ds=await navigator.mediaDevices.enumerateDevices();const n=ds.filter(d=>d.kind==='videoinput').length;$('diagCameras').textContent=n?n+' kamera':'0 terlihat'}catch(e){$('diagCameras').textContent='gagal'}
}
async function cameras(){
try{const ds=await navigator.mediaDevices.enumerateDevices();state.cameras=ds.filter(d=>d.kind==='videoinput').map((d,i)=>({id:d.deviceId,label:d.label||('Kamera '+(i+1))}));
const sel=$('camera');sel.innerHTML='<option value="">Kamera default</option>';state.cameras.forEach(c=>{const o=document.createElement('option');o.value=c.id;o.textContent=c.label;sel.appendChild(o)});if(state.activeId)sel.value=state.activeId;return state.cameras}catch(e){return []}}
function scanFormats(){const F=window.Html5QrcodeSupportedFormats;const m=$('mode').value;if(m==='BOOK')return [F.CODE_128];if(m==='MEMBER')return [F.QR_CODE,F.CODE_128];return [F.QR_CODE,F.CODE_128]}
function config(){return {fps:15,qrbox:(w,h)=>({width:Math.min(Math.floor(w*.90),620),height:Math.min(Math.floor(h*.36),180)}),aspectRatio:1.777,disableFlip:false,verbose:false}}
async function applyCameraEnhancements(){
const video=document.querySelector('#reader video');const track=video?.srcObject?.getVideoTracks?.()[0];state.track=track||null;if(!track)return;
try{const caps=track.getCapabilities?.()||{};if(Array.isArray(caps.focusMode)&&caps.focusMode.includes('continuous'))await track.applyConstraints({advanced:[{focusMode:'continuous'}]});if(caps.torch){$('torchBtn').hidden=false}else $('torchBtn').hidden=true;}catch(e){}
}
function postResult(code){code=String(code||'').trim();if(!code)return;const now=Date.now();if(code===state.last&&now-state.lastAt<1800)return;state.last=code;state.lastAt=now;beep();$('result').hidden=false;$('result').innerHTML='<div class="label">Hasil Scan</div><div class="code"></div><div class="meta">Kode terbaca dari kamera. PERPUS akan memvalidasinya.</div>';$('result').querySelector('.code').textContent=code;setStatus('ok','Kode terbaca: '+code);
const payload={type:'PERPUS_SCAN_RESULT',nonce:nonce,code:code,mode:$('mode').value,source:'PERPUS_SCANNER_REV7_HTML5QRCODE'};let delivered=false;
try{if(window.opener&&!window.opener.closed){window.opener.postMessage(payload,'*');delivered=true}}catch(e){}
try{if(embedded&&window.parent&&window.parent!==window){window.parent.postMessage(payload,'*');delivered=true}}catch(e){}
if(delivered){setMsg('ok','Kode berhasil dikirim kembali ke PERPUS. Scanner dihentikan.');postStatus('ok','Kode scan berhasil dikirim ke PERPUS.');setTimeout(()=>{stopScanner().finally(()=>{if(window.opener&&!embedded)try{window.close()}catch(e){}})},180)}else setMsg('warn','Scanner berdiri sendiri. Kode tetap ditampilkan di layar.');
}
async function startScanner(cameraId=''){
if(state.running)await stopScanner();
try{
if(!window.isSecureContext||!navigator.mediaDevices?.getUserMedia)throw new Error('Gunakan halaman HTTPS untuk akses kamera.');
if(typeof Html5Qrcode==='undefined'||typeof Html5QrcodeSupportedFormats==='undefined')throw new Error('Library scanner belum termuat. Muat ulang halaman.');
$('readerEmpty').style.display='none';setStatus('warn','Meminta izin dan menyalakan kamera...');setMsg('info','Meminta akses kamera. Pilih Izinkan/Allow bila diminta.');postStatus('info','Meminta izin kamera...');
state.scanner=new Html5Qrcode('reader',{formatsToSupport:scanFormats(),verbose:false});
const settings={...config()};const cameraConfig=cameraId?cameraId:{facingMode:{ideal:'environment'}};
await state.scanner.start(cameraConfig,settings,(decoded)=>postResult(decoded),()=>{});state.running=true;setStatus('ok','Kamera aktif. Arahkan barcode ke kotak scan.');setMsg('ok','Kamera aktif. Mode '+$('mode').value+'.');postStatus('ok','Kamera aktif.');
await new Promise(r=>setTimeout(r,250));await applyCameraEnhancements();await diagnostics();const cs=await cameras();if(!state.activeId&&cameraId)state.activeId=cameraId;else if(!state.activeId&&cs[0]){const v=cs.find(c=>/back|rear|environment/i.test(c.label))||cs[0];state.activeId=v.id;$('camera').value=v.id}
}catch(err){state.running=false;try{if(state.scanner)await state.scanner.stop()}catch(e){}try{if(state.scanner)await state.scanner.clear()}catch(e){}state.scanner=null;$('readerEmpty').style.display='flex';const n=String(err?.name||''),m=String(err?.message||'');if(n==='NotAllowedError'||/permission|denied/i.test(m)){setMsg('bad','Izin kamera ditolak. Izinkan kamera untuk domain Scanner.html lalu muat ulang.')}else if(n==='NotFoundError'){setMsg('bad','Kamera tidak ditemukan.')}else if(n==='NotReadableError'){setMsg('bad','Kamera sedang digunakan aplikasi lain atau diblokir OS.')}else setMsg('bad','Scanner gagal dimulai: '+(m||n||'error tidak dikenal'));setStatus('bad','Scanner belum aktif.');postStatus('bad','Scanner gagal dibuka: '+(m||n));await diagnostics()}
}
async function stopScanner(){try{if(state.torch&&state.track){try{await state.track.applyConstraints({advanced:[{torch:false}]})}catch(e){}}}catch(e){}try{if(state.scanner){if(state.running)try{await state.scanner.stop()}catch(e){}try{await state.scanner.clear()}catch(e){}}}catch(e){}state.scanner=null;state.running=false;state.track=null;state.torch=false;$('torchBtn').hidden=true;$('reader').innerHTML='';$('readerEmpty').style.display='flex';setStatus('warn','Scanner dihentikan.');await diagnostics()}
async function switchCamera(){const cs=state.cameras.length?state.cameras:await cameras();if(cs.length<2){setMsg('warn','Hanya satu kamera terlihat. Kamera default tetap dapat digunakan.');return}const i=cs.findIndex(c=>c.id===$('camera').value||c.id===state.activeId);const next=cs[(i+1+cs.length)%cs.length];$('camera').value=next.id;state.activeId=next.id;await startScanner(next.id)}
async function changeCamera(){const id=$('camera').value;if(id)await startScanner(id)}
async function torch(){if(!state.track){setMsg('warn','Kamera belum aktif.');return}try{const caps=state.track.getCapabilities?.()||{};if(!caps.torch){setMsg('warn','Fitur lampu/torch tidak tersedia pada kamera ini.');return}state.torch=!state.torch;await state.track.applyConstraints({advanced:[{torch:state.torch}]});$('torchBtn').textContent=state.torch?'Matikan Lampu':'Lampu';}catch(e){setMsg('warn','Lampu kamera tidak dapat diubah pada perangkat ini.')}}
async function testCamera(){await diagnostics();try{const s=await navigator.mediaDevices.getUserMedia({video:true,audio:false});const t=s.getVideoTracks()[0];const q=t.getSettings?.()||{};setMsg('ok','Tes kamera berhasil. Resolusi '+(q.width||'?')+'×'+(q.height||'?')+'. Sekarang klik “Izinkan & Mulai Kamera”.');s.getTracks().forEach(x=>x.stop());await cameras();await diagnostics()}catch(e){setMsg('bad','Tes kamera gagal: '+(e?.message||e?.name||'error'));await diagnostics()}}
async function testImage(){const f=$('barcodeFile').files?.[0];if(!f){setImgMsg('warn','Pilih gambar barcode terlebih dahulu.');return}if(typeof Html5Qrcode==='undefined'){setImgMsg('bad','Library scanner belum termuat.');return}const tempId='image-test-reader';const div=document.createElement('div');div.id=tempId;div.style.display='none';document.body.appendChild(div);try{const r=new Html5Qrcode(tempId,{formatsToSupport:[Html5QrcodeSupportedFormats.QR_CODE,Html5QrcodeSupportedFormats.CODE_128],verbose:false});const text=await r.scanFile(f,true);setImgMsg('ok','✓ Barcode terbaca dari gambar: '+text);try{await r.clear()}catch(e){}div.remove()}catch(e){setImgMsg('bad','Gambar belum berhasil dibaca: '+(e?.message||e?.name||'Tidak terdeteksi')+'. Coba gambar barcode yang lebih besar, tajam, hitam-putih, dan tidak terpotong.');try{div.remove()}catch(x){}}}
$('startBtn').addEventListener('click',()=>startScanner(''));$('switchBtn').addEventListener('click',switchCamera);$('stopBtn').addEventListener('click',()=>stopScanner());$('torchBtn').addEventListener('click',torch);$('camera').addEventListener('change',changeCamera);$('diagnosticBtn').addEventListener('click',testCamera);$('manualBtn').addEventListener('click',()=>postResult($('manual').value));$('manual').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();postResult(e.target.value)}});$('testImageBtn').addEventListener('click',testImage);
window.addEventListener('message',e=>{const d=e.data||{};if(d.type==='PERPUS_SCANNER_CANCEL')stopScanner();if(d.type==='PERPUS_SCANNER_SWITCH')switchCamera()});window.addEventListener('pagehide',()=>{try{if(state.scanner)state.scanner.stop()}catch(e){}});diagnostics();
})();
</script>
</body>
</html>
